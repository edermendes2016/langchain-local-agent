# Copie para .env para mudar o padrão (tudo é opcional).
LLM_MODEL=qwen2.5-coder:3b
EMBEDDING_MODEL=nomic-embed-text
# cross-encoder (mais preciso), bm25 (mais leve) ou none
RERANKER=cross-encoder
# repositórios indexados no primeiro start (nomes do docker/repos.docker.yaml)
BOOTSTRAP_REPOS=langchain
APP_PORT=8501
